generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// MODELS
// ═══════════════════════════════════════

model Tenant {
  id                 String    @id @default(uuid())
  name               String    // اسم المتجر / الشركة
  ownerName          String    // اسم التاجر / المالك
  phone              String?   // رقم الجوال
  email              String?   // البريد الإلكتروني
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  subscriptionEndsAt DateTime? // تاريخ انتهاء الاشتراك
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users           User[]
  invoices        Invoice[]
  employees       Employee[]
  activityLogs    ActivityLog[]
  systemSettings  SystemSettings[]
  activationCodes ActivationCode[]

  @@map("tenants")
}

model ActivationCode {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. "ERR-89A1-24BF-9901"
  durationDays   Int       // عدد الأيام (30, 60, 365, etc.)
  isUsed         Boolean   @default(false)
  usedByTenantId String?
  usedByTenant   Tenant?   @relation(fields: [usedByTenantId], references: [id])
  usedAt         DateTime?
  note           String?   // ملاحظة (مثل اسم العميل أو الدفعة)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@map("activation_codes")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("EMPLOYEE") // MASTER_ADMIN, SUPER_ADMIN, EMPLOYEE
  isMasterAdmin Boolean  @default(false)      // مالك النظام الرئيسي
  permissions   String   @default("[]")       // JSON string of permission IDs
  avatar        String?
  isActive      Boolean  @default(true)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices   Invoice[]
  activities ActivityLog[]

  @@index([tenantId])
  @@map("users")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   // رقم الفاتورة
  name          String
  description   String?
  amount        Float    @default(0)
  currency      String   @default("SAR") // SAR, USD
  category      String   // REVENUE, EXPENSE, RETURN, SALARY
  date          DateTime
  attachment    String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([createdById])
  @@index([invoiceNumber])
  @@index([employeeId])
  @@index([tenantId])
  @@map("invoices")
}

model Employee {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  position  String
  salary    Float    @default(0)
  currency  String   @default("SAR")
  isActive  Boolean  @default(true)
  hireDate  DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([tenantId])
  @@map("employees")
}

model SystemSettings {
  id              String   @id @default(uuid())
  companyName     String   @default("شركتي")
  companyLogo     String?
  primaryColor    String   @default("#6366f1")
  secondaryColor  String   @default("#8b5cf6")
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?
  defaultCurrency String   @default("SAR")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("system_settings")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, PRINT, EXPORT
  entityType String   // Invoice, Employee, User, Settings
  entityId   String?
  details    String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@index([tenantId])
  @@map("activity_logs")
}
